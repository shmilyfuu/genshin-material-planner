{
  "manifest_version": 3,
  "name": "全能养成规划面板（米游社测试）",
  "short_name": "养成规划·米游社测试",
  "version": "1.3.1",
  "description": "原神角色与武器养成材料规划侧边栏实验分支，修正米游社扫码登录二维码显示，并测试国服账号数据同步。",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://static.nanoka.cc/*",
    "https://api.lunaris.moe/*",
    "https://webapi.account.mihoyo.com/*",
    "https://passport-api.mihoyo.com/*",
    "https://api-takumi.mihoyo.com/*",
    "https://api-takumi-record.mihoyo.com/*",
    "https://bbs-api.mihoyo.com/*",
    "https://bbs-api.miyoushe.com/*",
    "https://public-data-api.mihoyo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开全能养成规划面板（米游社测试）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://static.nanoka.cc https://api.lunaris.moe"
  }
}
